{
  "name": "reels-installer",
  "version": "1.0.0",
  "description": "Download Instagram Reels using a link",
  "main": "dist/server/index.js",
  "scripts": {
    "build:client": "esbuild src/main.ts --bundle --outfile=public/bundle.js --platform=browser",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "dev:client": "esbuild src/main.ts --bundle --outfile=public/bundle.js --platform=browser --watch",
    "dev:server": "ts-node-dev --respawn --transpile-only --project tsconfig.server.json server/index.ts",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "start": "npm run build && node dist/server/index.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "instagram-url-direct": "^1.0.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
